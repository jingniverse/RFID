{
  "name": "rfid-smart-care-hub",
  "version": "1.6.0",
  "description": "방문요양 급여제공기록지 & RFID 스마트 통합 관리 대시보드",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "keywords": [
    "rfid",
    "longterm",
    "caregiver",
    "dashboard"
  ],
  "author": "jingniverse",
  "license": "MIT",
  "build": {
    "appId": "com.jingniverse.rfidhub",
    "productName": "RFID_HUB",
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "RFID_HUB_v1.6.0.exe"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!build_app/**",
      "!node_modules/**"
    ]
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
